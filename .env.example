# Local Docker Postgres (matches docker-compose.yml) — the intended default:
DATABASE_URL="postgresql://ptc:ptc_dev_password@localhost:5432/ptc_dev?schema=public"
# If using Neon (or another serverless/pooled Postgres) instead, use the POOLED
# endpoint (hostname contains "-pooler"), not the direct one — the direct
# endpoint drops idle connections on compute auto-suspend and surfaces as
# random "Can't reach database server" errors under normal page-to-page use:
# DATABASE_URL="postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/db?sslmode=require&pgbouncer=true&connect_timeout=15"
AUTH_SECRET="replace-with-openssl-rand-base64-32"
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="./storage"
EMAIL_DRIVER="console"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
